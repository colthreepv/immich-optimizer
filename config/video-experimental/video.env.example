# Disabled is the default. The disabled path copies the original bytes into a
# separate candidate path; it never invokes FFmpeg and never unlinks the source.
VIDEO_TRANSCODE_ENABLED=0

# Opt-in only. The script refuses to run with VIDEO_TRANSCODE_ENABLED=1 unless
# VIDEO_CODEC, VIDEO_PRESET and exactly one quality control are explicit.
# VIDEO_CODEC=libx265
# VIDEO_PRESET=medium
# VIDEO_CRF=24
#
# Alternative to VIDEO_CRF:
# VIDEO_BITRATE=4000k
#
# libx265 publishes an MP4 candidate; libsvtav1 publishes an MKV candidate.
# VIDEO_CODEC=libsvtav1
# VIDEO_PRESET=8
# VIDEO_CRF=32

# One encoder thread and one candidate at a time are intentional defaults for a
# modest CPU. The existing quiet-exec fan policy remains responsible for pausing
# the encoder process group above 3000 RPM.
# VIDEO_THREADS=1
# VIDEO_CONCURRENCY=1
# VIDEO_DURATION_TOLERANCE_SECONDS=0.5
# VIDEO_LOCK_DIR=/tmp/immich-optimizer-video-slots
